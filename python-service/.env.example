# Servicio FastAPI - valores ficticios, NO usar secretos reales aqui.

# Clave compartida con NestJS (header X-Internal-Api-Key). Obligatoria:
# sin ella los endpoints /ingest/* responden 401.
INTERNAL_API_KEY=change_me_internal_key

# Fuente web (PDF oficial del plan de estudios).
SOURCE_URL=https://pucv.cl/pucv/site/docs/20150611/20150611175606/ingenieria_civil_informatica_act__1_.pdf
# Contacto que se incluye en el User-Agent del extractor (correo del equipo).
SCRAPER_CONTACT= benjamin.peredo.d@mail.pucv.cl

# Descarga
SOURCE_CONNECT_TIMEOUT=5
SOURCE_READ_TIMEOUT=20
SOURCE_MAX_BYTES=10485760
CACHE_DIR=/tmp/listoco-cache

# Extraccion
EXPECTED_SEMESTERS=11